<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_mpi_helpdesk_zoho" model="ir.module.category">
            <field name="name">Zoho Desk Connector</field>
            <field name="sequence">55</field>
        </record>
        <record id="privilege_mpi_helpdesk_zoho" model="res.groups.privilege">
            <field name="name">Zoho Desk Connector</field>
            <field name="sequence">55</field>
            <field name="category_id" ref="module_category_mpi_helpdesk_zoho"/>
        </record>
        <record id="group_zoho_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_mpi_helpdesk_zoho"/>
            <field name="implied_ids" eval="[(4, ref('helpdesk.group_helpdesk_manager'))]"/>
            <field name="comment">Configure Connections, maps, and Zoho self-client credentials.</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
    <data noupdate="1">
        <record id="rule_connection_company" model="ir.rule">
            <field name="name">Connection: company</field>
            <field name="model_id" ref="model_mpi_zoho_desk_connection"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
