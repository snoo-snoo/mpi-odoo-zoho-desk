<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_ticket_form_zoho" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.zoho</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Zoho Desk" name="mpi_zoho_desk">
                    <field name="mpi_zoho_desk_ticket_url" invisible="1"/>
                    <label for="mpi_zoho_desk_ticket_id"/>
                    <div class="o_row">
                        <field name="mpi_zoho_desk_ticket_id" nolabel="1" readonly="1"/>
                        <button name="action_open_mpi_zoho_desk_ticket" type="object"
                                string="Open in Zoho Desk" icon="fa-external-link"
                                class="btn-link" invisible="not mpi_zoho_desk_ticket_url"/>
                    </div>
                    <field name="mpi_zoho_source_removed"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
